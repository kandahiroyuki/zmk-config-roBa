#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        hidari_kakko {
            bindings = <&kp LS(N8)>;
            key-positions = <3 2>;
        };

        migi_kakko {
            bindings = <&kp LS(N9)>;
            key-positions = <6 7>;
        };

        hidari_daikakko {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <13 12>;
        };

        migi_daikakko {
            bindings = <&kp NON_US_HASH>;
            key-positions = <18 19>;
        };

        hidari_tyuukakko {
            bindings = <&kp LS(RIGHT_BRACKET)>;
            key-positions = <25 24>;
        };

        migi_tyuukakko {
            bindings = <&kp LS(NON_US_HASH)>;
            key-positions = <30 31>;
        };

        HANZEN {
            bindings = <&kp TILDE>;
            key-positions = <1 2>;
        };

        change_layer6 {
            bindings = <&lt 6 B>;
            key-positions = <26>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R  &kp T                                                       &kp Y                  &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F  &kp G                 &kp LS(LG(S))         &kp BACKSPACE   &kp H                  &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V  &kp B                 &kp INT_MUHENKAN      &kp INT_HENKAN  &kp N                  &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &mo 3  &mt LEFT_SHIFT SPACE  &lt 1 TAB             &lt 2 ENTER     &mt RIGHT_SHIFT SPACE                             &kp ESC
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        kigou {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR      &kp PERCENT                       &kp CARET  &kp AMPERSAND      &kp PLUS   &kp LS(INT_YEN)   &kp INT_YEN
&trans           &trans       &trans    &kp LEFT_BRACE  &kp EQUAL    &trans      &kp DEL  &kp COLON  &kp DOUBLE_QUOTES  &kp UNDER  &kp LEFT_BRACKET  &kp LS(MINUS)
&trans           &trans       &trans    &trans          &trans       &trans      &trans   &kp MINUS  &kp SLASH          &kp SEMI   &kp SINGLE_QUOTE  &trans
&trans           &trans       &trans    &trans          &trans       &trans      &trans   &trans                                                     &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4           &kp F5                                                        &trans  &kp HOME            &kp UP_ARROW    &kp END              &kp PAGE_UP
&kp F6   &kp F7   &kp F8   &kp F9           &kp F10              &kp LC(LA(KP_NUMBER_0))      &kp DELETE  &trans  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp PAGE_DOWN
&kp F11  &kp F12  &kp INS  &kp PRINTSCREEN  &kp LG(PRINTSCREEN)  &trans                       &trans      &trans  &kp LS(LEFT_ARROW)  &kp TAB         &kp LS(RIGHT_ARROW)  &kp SCROLLLOCK
&trans   &trans   &trans   &trans           &trans               &trans                       &trans      &trans                                                           &trans
            >;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                            &kp LS(KP_EQUAL)  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SLASH
&trans  &trans  &trans  &trans  &trans  &trans      &kp DELETE    &kp SINGLE_QUOTE  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_ASTERISK
&trans  &trans  &trans  &trans  &trans  &trans      &kp KP_COMMA  &kp KP_EQUAL      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MINUS
&trans  &trans  &trans  &trans  &trans  &trans      &kp KP_DOT    &kp KP_NUMBER_0                                                      &kp KP_PLUS
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        BloueTooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
